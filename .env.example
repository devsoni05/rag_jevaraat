# Required for product data access
MONGO_URI=
MONGO_DB_NAME=jevaraat

# Required for the LLM provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional vector store settings
CHROMA_PERSIST_DIRECTORY=chroma-db
CHROMA_COLLECTION_NAME=jevaraat_products
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
